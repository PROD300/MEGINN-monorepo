   --gray-500: #64748B;
   --gray-700: #334155;
   --gray-900: #0F172A;
@@ -43,6 +52,17 @@
   --error-500:   #1C7EA0;
   --info-500:    #1C7EA0;
 
+  /* === Code syntax — the one sanctioned exception to accent convergence,
+     tokenised 2026-09-14. These two hues were sitting as raw hex literals in
+     landing.css (.num / .str), i.e. outside the system entirely, which is what
+     ds/CONTRACT.md forbids. Values are unchanged — this only gives them names so
+     a future accent change can reason about them instead of missing them. They
+     deliberately do NOT converge on the accent: inside a code block hue is the
+     only thing separating a number from a string, and there is no icon or label
+     to carry that distinction the way there is for status. === */
+  --syntax-number: #6EE7B7;
+  --syntax-string: #FBBF24;
+
   /* === Typography === */
   /* Rebrand 2026-08-09: Inter → Geist + Geist Mono, approved — see
      HANDOFF_COWORK_TYPOGRAPHY_2026-08-09.md for rationale and sourcing. */
diff --git a/app/src/tokens/semantics.css b/app/src/tokens/semantics.css
index d0373ec..027e8ea 100644
--- a/app/src/tokens/semantics.css
+++ b/app/src/tokens/semantics.css
@@ -42,6 +42,20 @@
   --text-info:      var(--info-500);
   --text-accent:    var(--accent-300);
   --text-accent-hover: var(--accent-700); /* secondary/ghost/icon-button text on hover — surface-hover (gray-300) is a light bg, accent-300 loses contrast there */
+  --text-placeholder: var(--gray-400); /* added 2026-09-14 — input placeholders,
+    app and landing. Previously there was no token: the landing left ::placeholder
+    unset and inherited the browser default (#757575, off-system and below AA),
+    while Input.module.css pointed placeholders at text-muted — the same value as
+    the input's own text, so an empty field looked filled. Use only for
+    placeholder/ghost text inside form controls; hint text under a field is
+    text-subtle. */
+
+  /* === Code syntax === */
+  --text-code-keyword: var(--accent-300);
+  --text-code-number:  var(--syntax-number);
+  --text-code-string:  var(--syntax-string);
+  --text-code-punct:   var(--gray-300);
+  --text-code-comment: var(--text-muted);
 
   /* === Borders === */
   --border-default: var(--gray-700);
